<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:fitsSystemWindows="false">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/octopus_green"
        android:visibility="gone" />

    <!-- 站点切换入口：左下角小号半透明浮动按钮 -->
    <ImageButton
        android:id="@+id/btn_switch_site"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.65"
        android:background="@drawable/bg_switch"
        android:contentDescription="@string/switch_site"
        android:padding="7dp"
        android:src="@drawable/ic_sites"
        android:visibility="gone" />

    <!-- 启动页：App 图标 + 加载指示，页面加载完成后淡出 -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:contentDescription="@string/app_name"
            android:importantForAccessibility="no"
            android:src="@drawable/octopus_logo" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/octopus_green"
            android:progressTint="@color/octopus_green" />
    </LinearLayout>

    <!-- 错误页 -->
    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.9"
            android:contentDescription="@string/app_name"
            android:importantForAccessibility="no"
            android:src="@drawable/octopus_logo" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/error_title"
            android:textColor="@color/error_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/error_sub"
            android:textColor="@color/error_text_sub"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/octopus_green"
            android:minWidth="160dp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:text="@string/retry"
            android:textColor="@android:color/white" />
    </LinearLayout>
</FrameLayout>